# CS1 智慧学工管理系统 —— 环境变量模板
# 复制为 .env.local（本地开发）或 /etc/cs1.env（生产 systemd 环境），填入真实值。
# 本文件只含变量名与说明，禁止提交任何真实凭据。

# PostgreSQL 连接串（必需，应用与所有 db:* 脚本都依赖它）
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cs1

# 数据库连接池上限（可选，默认 10）
DATABASE_POOL_SIZE=10

# 初始管理员账号（npm run db:seed 使用）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 虚构测试数据（npm run db:seed:test 使用，均可选）
# TEST_DATA_SEED 固定后可复现同一批数据
TEST_DATA_SEED=
TEST_DATA_STUDENTS=500
TEST_DATA_RECORDS_PER_FEATURE=8
# 测试账号统一密码，至少 12 个字符
TEST_USER_PASSWORD=

# API 集成测试目标地址（tests/api-integration.test.mjs，可选，默认 http://127.0.0.1:4180）
TEST_BASE_URL=

# 说明：NODE_ENV / HOSTNAME / PORT 由 Next.js 与 deploy/cs1.service 提供，无需在此配置。
