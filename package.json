{
  "name": "cs1-student-affairs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run && npm run test:node",
    "test:node": "node --import ./tests/register-alias.mjs --test \"tests/*.test.mjs\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-admin.mjs",
    "db:seed:test": "node --env-file=.env.local scripts/seed-full-test-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  },
  "type": "module"
}
